# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # `:linkage => :static` is required, not a preference. Three of our pods
  # declare `static_framework = true` in their own podspecs — firebase_core,
  # firebase_messaging, and mobile_scanner (which drags in the whole
  # GoogleMLKit/BarcodeScanning tree). Under a plain `use_frameworks!` those
  # are built as static libs inside framework wrappers while the rest of the
  # pods stay dynamic, so the shared Google runtime (GoogleUtilities,
  # GoogleDataTransport, nanopb) ends up linked twice: once into the app
  # binary, once into a dynamic framework. The duplicate Objective-C classes
  # register against each other at load time, which aborts before Dart ever
  # runs — a launch crash on every device, which is what App Review saw.
  # Static everywhere gives exactly one copy of each.
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # permission_handler_apple compiles each permission behind a macro that
      # defaults to 0 (see PermissionHandlerEnums.h). Without these, the
      # matching strategy class compiles to an empty stub: the plugin never
      # calls AVFoundation, so iOS never shows the permission alert and the
      # Info.plist purpose string is never displayed. Opting in is mandatory,
      # not an optimisation — this is what the plugin's own example Podfile
      # does. Only list what the app actually asks for; every unlisted
      # permission stays compiled out.
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] if defs.is_a?(String)
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs | [
        '$(inherited)',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_PHOTOS_ADD_ONLY=1',
      ]
    end
  end
end
